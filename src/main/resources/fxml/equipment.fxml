<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.crmdesktop.controller.EquipmentController"
            style="-fx-background-color: #f4f6f8;">
    <top><HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #263238;">
        <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
        <Button text="← Dashboard" onAction="#backToDashboard"/>
        <Button text="Reparaciones" onAction="#openRepairs"/>
        <Label text="Equipos" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
    </HBox></top>
    <center><VBox spacing="14">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        <HBox spacing="8"><TextField fx:id="txtSearch" promptText="Buscar por número de serie..." HBox.hgrow="ALWAYS"/>
            <Button text="Buscar" onAction="#searchEquipment"/></HBox>
        <TableView fx:id="tableEquipment" VBox.vgrow="ALWAYS"><columns>
            <TableColumn fx:id="colType" text="Tipo" prefWidth="150"/>
            <TableColumn fx:id="colBrand" text="Marca" prefWidth="150"/>
            <TableColumn fx:id="colModel" text="Modelo" prefWidth="150"/>
            <TableColumn fx:id="colSerial" text="N° de serie" prefWidth="180"/>
            <TableColumn fx:id="colClient" text="Cliente" prefWidth="240"/>
        </columns></TableView>
        <Label text="Datos del equipo" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <GridPane hgap="10" vgap="10">
            <TextField fx:id="txtType" promptText="Tipo (PC, notebook...)" GridPane.columnIndex="0"/>
            <TextField fx:id="txtBrand" promptText="Marca" GridPane.columnIndex="1"/>
            <TextField fx:id="txtModel" promptText="Modelo" GridPane.columnIndex="2"/>
            <TextField fx:id="txtSerial" promptText="Número de serie" GridPane.columnIndex="3"/>
            <ComboBox fx:id="cmbClient" promptText="Cliente" GridPane.columnIndex="4"/>
        </GridPane>
        <HBox spacing="10"><Button text="Nuevo / Limpiar" onAction="#clearForm"/>
            <Button text="Guardar equipo" onAction="#saveEquipment"/>
            <Button text="Eliminar equipo" onAction="#deleteEquipment"/></HBox>
    </VBox></center>
</BorderPane>
